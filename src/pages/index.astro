---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

// ضع معرّفات التتبع هنا بين علامتي الاقتباس. اتركها فارغة وسيتجاهلها الموقع.
const GA_MEASUREMENT_ID = ""; // مثال: G-XXXXXXXXXX
const META_PIXEL_ID = "";     // مثال: 123456789012345
const GSC_VERIFICATION = "";  // كود التحقق من Google Search Console

const title = 'الخياط للترجمة المعتمدة | ترجمة معتمدة للسفارات والجهات الرسمية في مصر والوطن العربي';
const description =
  'ترجمة معتمدة لجميع اللغات للسفارات والقنصليات والوثائق الرسمية، أونلاين لعملائنا في مصر والوطن العربي. المقر: دمياط، مصر. أرسل مستندك واتساب واعرف السعر والموعد.';

const services = [
  { t: 'ترجمة معتمدة للسفارات والقنصليات', d: 'شهادات الميلاد والزواج والطلاق وصحيفة الحالة الجنائية والقيد العائلي وكشوف الحساب البنكية، لملفات تأشيرات شنجن وأمريكا وكندا والخليج.' },
  { t: 'الترجمة القانونية والعقود', d: 'التوكيلات الرسمية وعقود تأسيس الشركات والأحكام القضائية والسجلات التجارية والبطاقات الضريبية بمصطلحات قانونية دقيقة.' },
  { t: 'الترجمة الأكاديمية والعلمية', d: 'شهادات التخرج وكشوف الدرجات ورسائل الماجستير والدكتوراه والأبحاث العلمية للجامعات الأجنبية ومنح الدراسة بالخارج.' },
  { t: 'الترجمة الطبية والتقارير', d: 'التقارير الطبية والتحاليل والأشعة ونشرات الأدوية وشهادات التطعيم للمستشفيات وجهات العلاج بالخارج.' },
  { t: 'الترجمة المالية والتجارية', d: 'الميزانيات والقوائم المالية ودراسات الجدوى وخطط الأعمال والمراسلات التجارية للشركات والمؤسسات.' },
];

const why = [
  { t: 'اعتماد رسمي', d: 'ترجمة مختومة ومعتمدة تُقبل لدى الجهات الرسمية.' },
  { t: 'دقة لغوية', d: 'كل ترجمة تُراجع قبل التسليم للتأكد من الأسماء والتواريخ والمصطلحات.' },
  { t: 'سرعة التنفيذ', d: 'نحدد لك موعد التسليم قبل البدء، ونلتزم به.' },
  { t: 'سرية تامة', d: 'مستنداتك لا تُشارك مع أي طرف خارج فريق الترجمة.' },
  { t: 'إرسال واستلام بسهولة', d: 'أرسل المستند واتساب، واستلمه أونلاين من أي مكان، أو من مقرنا في دمياط. ونشحن لجميع محافظات مصر.' },
];

const steps = [
  { t: 'أرسل صورة المستند', d: 'صوّر مستندك بوضوح وأرسله إلينا على واتساب.' },
  { t: 'اعرف التكلفة والموعد', d: 'نرد عليك بالسعر وموعد التسليم قبل أي التزام.' },
  { t: 'الترجمة والمراجعة', d: 'يُترجم المستند ثم يُراجع ويُعتمد من المترجم المختص.' },
  { t: 'استلم مستندك مختوماً', d: 'استلمه من المكتب في دمياط، أو أونلاين، أو بالشحن.' },
];

const languages = [
  { n: 'الإنجليزية', d: 'سفارات بريطانيا وأمريكا وكندا وأستراليا.' },
  { n: 'الألمانية', d: 'سفارات ألمانيا والنمسا وسويسرا، ومعادلة الشهادات.' },
  { n: 'الفرنسية', d: 'سفارات فرنسا وبلجيكا وكندا (كيبيك).' },
  { n: 'الإيطالية', d: 'سفارة إيطاليا، ولمّ الشمل والدراسة والعمل.' },
  { n: 'الإسبانية', d: 'سفارة إسبانيا ودول أمريكا اللاتينية.' },
  { n: 'الروسية والصينية', d: 'التبادل التجاري والدراسة والوثائق الرسمية.' },
  { n: 'التركية', d: 'الإقامة والدراسة والتجارة والوثائق الرسمية.' },
];

const welcomes = [
  { t: 'Welcome', l: 'en' },
  { t: 'أهلاً وسهلاً', l: 'ar' },
  { t: 'Bienvenue', l: 'fr' },
  { t: 'Willkommen', l: 'de' },
  { t: 'Bienvenido', l: 'es' },
  { t: 'Benvenuto', l: 'it' },
  { t: 'Добро пожаловать', l: 'ru' },
  { t: '欢迎', l: 'zh' },
  { t: 'Hoş geldiniz', l: 'tr' },
  { t: 'Bem-vindo', l: 'pt' },
  { t: 'ようこそ', l: 'ja' },
  { t: '환영합니다', l: 'ko' },
  { t: 'स्वागत', l: 'hi' },
  { t: 'Καλώς ορίσατε', l: 'el' },
  { t: 'Welkom', l: 'nl' },
  { t: 'Välkommen', l: 'sv' },
  { t: 'Selamat datang', l: 'id' },
  { t: 'Karibu', l: 'sw' },
  { t: 'Witamy', l: 'pl' },
];

const faqs = [
  { q: 'هل الترجمة مقبولة لدى جميع السفارات والجهات الحكومية؟',
    a: 'نعم، جميع الترجمات مختومة ومعتمدة وتُقبل لدى كافة السفارات والقنصليات والوزارات والجهات الرسمية داخل مصر وخارجها.' },
  { q: 'هل تترجمون أي مستند ترجمة معتمدة؟',
    a: 'الترجمة المعتمدة لدينا خاصة بالوثائق الحقيقية والأصلية فقط. أرسل صورة واضحة للمستند وسنؤكد لك التفاصيل.' },
  { q: 'هل أحتاج للحضور إلى المكتب لتسليم المستندات؟',
    a: 'لا يشترط. يمكنك تصوير المستند بوضوح وإرساله عبر واتساب، واستلام الترجمة المعتمدة في دمياط أو أونلاين بصيغة PDF مختومة أو عبر الشحن لأي محافظة.' },
  { q: 'كم يستغرق وقت الترجمة وكيف يتم تحديد التكلفة؟',
    a: 'يتم تحديد التكلفة وموعد التسليم بدقة فور إرسال صورة المستند عبر واتساب، وغالباً ما تُنجز الوثائق الرسمية والشهادات في نفس اليوم أو خلال 24 ساعة.' },
  { q: 'ما هي طرق الدفع المتاحة؟',
    a: 'تتوفر عدة طرق للدفع: التحويل البنكي، وإنستا باي، والمحافظ الإلكترونية، والدفع النقدي (كاش).' },
  { q: 'كيف أضمن مطابقة الأسماء لبيانات جواز السفر؟',
    a: 'نراجع كافة الأسماء والتواريخ بدقة، ونطلب إرفاق صورة جواز السفر أو كتابة الحروف المعتمدة لضمان التطابق التام 100%.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  title={title}
  description={description}
  gaId={GA_MEASUREMENT_ID}
  pixelId={META_PIXEL_ID}
  gscVerification={GSC_VERIFICATION}
  extraSchemas={[faqSchema]}
>
  <Header />
  <main>
    <section class="hero hero--visual">
      <picture class="hero__bg">
        <source media="(min-width: 900px)" srcset="/images/hero-desktop.webp" width="1920" height="900" />
        <img src="/images/hero-mobile.webp" width="900" height="620"
          alt="أعلام دول العالم وكرة أرضية عملاقة ترمز إلى ترجمة معتمدة بأكثر من 100 لغة - الخياط للترجمة المعتمدة"
          loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <div class="container hero__grid">
        <div class="hero__text">
        <h1>الخياط للترجمة المعتمدة – ترجمة دقيقة ومعتمدة لكافة السفارات والجهات الرسمية في مصر والوطن العربي</h1>
        <p>
          نخدم عملاءنا في مصر والوطن العربي أونلاين، بجميع اللغات وبدقة لغوية عالية وختم واعتماد رسمي.
          أرسل صورة المستند الآن واعرف التكلفة وموعد التسليم قبل أن تبدأ.
        </p>
        <div class="hero__cta">
          <a class="btn btn--wa" href={SITE.whatsapp} data-track="whatsapp" data-loc="hero" rel="noopener">
            أرسل مستندك عبر واتساب لتقييم السعر والوقت
          </a>
          <a class="btn btn--ghost" href={SITE.tel} data-track="call" data-loc="hero">اتصال هاتفي مباشر</a>
        </div>
        <ul class="stats">
          <li><strong>+15,000</strong><span>وثيقة مترجمة ومعتمدة</span></li>
          
          <li><strong>24 ساعة</strong><span>موعد تسليم أغلب الوثائق الرسمية</span></li>
          <li class="stats__wide"><strong>ترجمة معتمدة للمستندات بأكثر من 100 لغة حول العالم!</strong></li>
        </ul>
        </div>
      </div>
    </section>

    <section class="section" id="services">
      <div class="container">
        <div class="section__head">
          <h2>خدمات الترجمة</h2>
          <p>نغطي أنواع المستندات التي يحتاجها الأفراد والشركات في مصر وخارجها.</p>
        </div>
        <ul class="list">
          {services.map((s) => (
            <li class="item">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <a href={`${SITE.whatsappBase}?text=${encodeURIComponent('مرحباً، أرغب في طلب خدمة: ' + s.t)}`}
                data-track="whatsapp" data-loc="service" target="_blank" rel="noopener">اطلب هذه الخدمة ←</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section--surface" id="languages">
      <div class="container">
        <div class="section__head">
          <h2>اللغات التي نترجمها</h2>
          <p>ترجمة معتمدة لجميع اللغات، من العربية وإليها.</p>
        </div>
        <div class="mosaic" role="img" aria-label="كلمة «أهلاً بك» مكتوبة بعدة لغات">
          {welcomes.map((w, i) => (
            <span class={i === 0 ? 'tile--lg' : undefined} lang={w.l}>{w.t}</span>
          ))}
        </div>
        <ul class="list">
          {languages.map((l) => (
            <li class="item"><h3>اللغة {l.n}</h3><p>{l.d}</p></li>
          ))}
        </ul>
        <p class="langs-note">وجميع اللغات الأخرى. أرسل مستندك وسنؤكد لك الموعد والتكلفة.</p>
      </div>
    </section>

    <section class="section section--ice" id="why">
      <div class="container">
        <div class="section__head">
          <h2>لماذا تختار الخياط للترجمة المعتمدة</h2>
        </div>
        <div class="split">
          <ul class="list list--stack">
            {why.map((w) => (
              <li class="item"><h3>{w.t}</h3><p>{w.d}</p></li>
            ))}
          </ul>
          <img class="media" src="/images/trust-banner.webp" width="1200" height="600"
            alt="مصافحة تعبّر عن الثقة والموثوقية في خدمات الخياط للترجمة المعتمدة"
            loading="lazy" decoding="async" />
        </div>
      </div>
    </section>

    <section class="section" id="steps">
      <div class="container">
        <div class="section__head">
          <h2>كيف تطلب الخدمة</h2>
          <p>أربع خطوات، وكلها من هاتفك.</p>
        </div>
        <img class="media media--wide" src="/images/journey-banner.webp" width="1200" height="500"
          alt="طلب ترجمة معتمدة أونلاين عبر واتساب من مكتب الخياط للترجمة المعتمدة بدمياط"
          loading="lazy" decoding="async" />
        <ol class="steps">
          {steps.map((s) => (
            <li><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>
        <div class="hero__cta">
          <a class="btn btn--wa" href={SITE.whatsapp} data-track="whatsapp" data-loc="steps" rel="noopener">
            ابدأ الآن: أرسل مستندك عبر واتساب
          </a>
        </div>
      </div>
    </section>
    <section class="section section--surface" id="faq">
      <div class="container">
        <div class="section__head">
          <h2>الأسئلة الشائعة</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
