---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

// ضع معرّفات التتبع هنا بين علامتي الاقتباس. اتركها فارغة وسيتجاهلها الموقع.
const GA_MEASUREMENT_ID = ""; // مثال: G-XXXXXXXXXX
const META_PIXEL_ID = "";     // مثال: 123456789012345
const GSC_VERIFICATION = "";  // كود التحقق من Google Search Console

const title = 'الخياط للترجمة المعتمدة بدمياط | ترجمة معتمدة للسفارات والجهات الرسمية';
const description =
  'مكتب ترجمة معتمدة في دمياط، مصر. ترجمة دقيقة ومختومة للسفارات والقنصليات والوثائق الرسمية والقانونية والطبية. أرسل مستندك واتساب واعرف السعر والموعد.';

const services = [
  { t: 'ترجمة معتمدة للسفارات والقنصليات', d: 'ملفات التأشيرات والهجرة والإقامة بالصيغة التي تقبلها السفارات والقنصليات.' },
  { t: 'الوثائق الرسمية والشهادات', d: 'شهادات الميلاد والزواج والتخرج وكشوف الدرجات وصحيفة الحالة الجنائية.' },
  { t: 'الترجمة القانونية والعقود', d: 'عقود وتوكيلات وأحكام ومستندات شركات بمصطلحات قانونية دقيقة.' },
  { t: 'الترجمة الطبية', d: 'تقارير وروشتات ونتائج تحاليل وملفات طبية بدقة في الأسماء والمصطلحات.' },
  { t: 'الترجمة الأكاديمية والتجارية', d: 'أبحاث ورسائل علمية، وملفات تجارية ومراسلات وكتالوجات.' },
];

const why = [
  { t: 'اعتماد رسمي', d: 'ترجمة مختومة ومعتمدة تُقبل لدى الجهات الرسمية.' },
  { t: 'دقة لغوية', d: 'كل ترجمة تُراجع قبل التسليم للتأكد من الأسماء والتواريخ والمصطلحات.' },
  { t: 'سرعة التنفيذ', d: 'نحدد لك موعد التسليم قبل البدء، ونلتزم به.' },
  { t: 'سرية تامة', d: 'مستنداتك لا تُشارك مع أي طرف خارج فريق الترجمة.' },
  { t: 'إرسال واستلام بسهولة', d: 'أرسل المستند واتساب، واستلمه أونلاين أو من مقرنا في دمياط. نشحن لجميع المحافظات.' },
];

const steps = [
  { t: 'أرسل صورة المستند', d: 'صوّر مستندك بوضوح وأرسله إلينا على واتساب.' },
  { t: 'اعرف التكلفة والموعد', d: 'نرد عليك بالسعر وموعد التسليم قبل أي التزام.' },
  { t: 'الترجمة والمراجعة', d: 'يُترجم المستند ثم يُراجع ويُعتمد من المترجم المختص.' },
  { t: 'استلم مستندك مختوماً', d: 'استلمه من المكتب في دمياط، أو أونلاين، أو بالشحن.' },
];

const languages = [
  'الإنجليزية', 'الفرنسية', 'الألمانية', 'الإيطالية', 'الإسبانية',
  'الروسية', 'الصينية', 'التركية', 'وغيرها من اللغات المعتمدة للسفارات',
];

const faqs = [
  { q: 'هل الترجمة مقبولة لدى جميع السفارات والجهات الحكومية؟',
    a: 'نعم، جميع الترجمات مختومة ومعتمدة وتُقبل لدى كافة السفارات والقنصليات والوزارات والجهات الرسمية داخل مصر وخارجها.' },
  { q: 'هل أحتاج للحضور إلى المكتب لتسليم المستندات؟',
    a: 'لا يشترط. يمكنك تصوير المستند بوضوح وإرساله عبر واتساب، واستلام الترجمة المعتمدة في دمياط أو أونلاين بصيغة PDF مختومة أو عبر الشحن لأي محافظة.' },
  { q: 'كم يستغرق وقت الترجمة وكيف يتم تحديد التكلفة؟',
    a: 'يتم تحديد التكلفة وموعد التسليم بدقة فور إرسال صورة المستند عبر واتساب، وغالباً ما تُنجز الوثائق الرسمية والشهادات في نفس اليوم أو خلال 24 ساعة.' },
  { q: 'كيف أضمن مطابقة الأسماء لبيانات جواز السفر؟',
    a: 'نراجع كافة الأسماء والتواريخ بدقة، ونطلب إرفاق صورة جواز السفر أو كتابة الحروف المعتمدة لضمان التطابق التام 100%.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  title={title}
  description={description}
  gaId={GA_MEASUREMENT_ID}
  pixelId={META_PIXEL_ID}
  gscVerification={GSC_VERIFICATION}
  extraSchemas={[faqSchema]}
>
  <Header />
  <main>
    <section class="hero">
      <div class="container">
        <h1>الخياط للترجمة المعتمدة بدمياط – ترجمة دقيقة ومعتمدة لكافة السفارات والجهات الرسمية</h1>
        <p>
          نترجم مستنداتك بدقة لغوية عالية وفي أسرع وقت، بختم واعتماد رسمي.
          أرسل صورة المستند الآن واعرف التكلفة وموعد التسليم قبل أن تبدأ.
        </p>
        <div class="hero__cta">
          <a class="btn btn--wa" href={SITE.whatsapp} data-track="whatsapp" data-loc="hero" rel="noopener">
            أرسل مستندك عبر واتساب لتقييم السعر والوقت
          </a>
          <a class="btn btn--ghost" href={SITE.tel} data-track="call" data-loc="hero">اتصال هاتفي مباشر</a>
        </div>
      </div>
    </section>

    <section class="section" id="services">
      <div class="container">
        <div class="section__head">
          <h2>خدمات الترجمة</h2>
          <p>نغطي أنواع المستندات التي يحتاجها الأفراد والشركات في مصر وخارجها.</p>
        </div>
        <ul class="list">
          {services.map((s) => (
            <li class="item"><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section--surface" id="languages">
      <div class="container">
        <div class="section__head">
          <h2>اللغات التي نترجمها</h2>
          <p>نترجم من العربية وإليها بين أكثر اللغات طلباً لدى السفارات والجهات الرسمية.</p>
        </div>
        <ul class="langs">
          {languages.map((l) => <li>{l}</li>)}
        </ul>
      </div>
    </section>

    <section class="section section--ice" id="why">
      <div class="container">
        <div class="section__head">
          <h2>لماذا تختار الخياط للترجمة المعتمدة</h2>
        </div>
        <ul class="list">
          {why.map((w) => (
            <li class="item"><h3>{w.t}</h3><p>{w.d}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="steps">
      <div class="container">
        <div class="section__head">
          <h2>كيف تطلب الخدمة</h2>
          <p>أربع خطوات، وكلها من هاتفك.</p>
        </div>
        <ol class="steps">
          {steps.map((s) => (
            <li><h3>{s.t}</h3><p>{s.d}</p></li>
          ))}
        </ol>
        <div class="hero__cta">
          <a class="btn btn--wa" href={SITE.whatsapp} data-track="whatsapp" data-loc="steps" rel="noopener">
            ابدأ الآن: أرسل مستندك عبر واتساب
          </a>
        </div>
      </div>
    </section>
    <section class="section section--surface" id="faq">
      <div class="container">
        <div class="section__head">
          <h2>الأسئلة الشائعة</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
