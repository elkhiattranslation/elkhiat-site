---
import '@fontsource-variable/cairo';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  gaId?: string;
  pixelId?: string;
  gscVerification?: string;
  extraSchemas?: object[];
}
const { title, description, gaId = '', pixelId = '', gscVerification = '', extraSchemas = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = `${SITE.url}/og-image.jpg`;

const GA = gaId;
const PIXEL = pixelId;
const GSC = gscVerification;

const knowsLanguage = [
  ['Arabic', 'ar'],
  ['English', 'en'],
  ['French', 'fr'],
  ['German', 'de'],
  ['Italian', 'it'],
  ['Spanish', 'es'],
  ['Russian', 'ru'],
  ['Chinese', 'zh'],
  ['Turkish', 'tr'],
  ['Japanese', 'ja'],
  ['Korean', 'ko'],
  ['Hindi', 'hi'],
  ['Portuguese', 'pt'],
  ['Greek', 'el'],
  ['Dutch', 'nl'],
  ['Swedish', 'sv'],
  ['Polish', 'pl'],
  ['Romanian', 'ro'],
  ['Ukrainian', 'uk'],
  ['Hebrew', 'he'],
  ['Persian', 'fa'],
  ['Urdu', 'ur'],
  ['Indonesian', 'id'],
  ['Swahili', 'sw'],
  ['Vietnamese', 'vi'],
].map(([name, code]) => ({ '@type': 'Language', name, alternateName: code }));

const allWeek = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: SITE.nameEn,
  url: SITE.url,
  logo: `${SITE.url}/logo.png`,
  image: ogImage,
  description,
  telephone: '+201200014211',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'دمياط',
    addressRegion: 'محافظة دمياط',
    addressCountry: 'EG',
  },
  hasMap: SITE.maps,
  sameAs: [SITE.social.facebook, SITE.social.instagram, SITE.social.x],
  areaServed: [
    { '@type': 'Country', name: 'Egypt' },
    { '@type': 'Place', name: 'Arab world' },
    { '@type': 'Place', name: 'Worldwide' },
  ],
  knowsLanguage,
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
    opens: '08:00',
    closes: '16:00',
  }],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+201200014211',
    contactType: 'customer service',
    availableLanguage: ['Arabic', 'English'],
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: allWeek,
      opens: '00:00',
      closes: '23:59',
    },
  },
};
const schemas = [schema, ...extraSchemas];
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0F172A" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {GSC && <meta name="google-site-verification" content={GSC} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {GA && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA}`}></script>
        <script is:inline define:vars={{ GA }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA);
        </script>
      </>
    )}

    {PIXEL && (
      <script is:inline define:vars={{ PIXEL }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
        document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', PIXEL);
        fbq('track', 'PageView');
      </script>
    )}

    <!-- تتبع التحويلات: أي عنصر فيه data-track="whatsapp|call" -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-track]');
        if (!el) return;
        var type = el.getAttribute('data-track');
        var loc = el.getAttribute('data-loc') || 'unknown';
        if (window.gtag) {
          gtag('event', 'generate_lead', { method: type, placement: loc });
        }
        if (window.fbq) {
          fbq('track', 'Contact', { method: type, placement: loc });
        }
      });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
